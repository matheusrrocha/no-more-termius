# Maintainer: Matheus Rocha <matheus.rocha@liplynig.com>

pkgname=no-more-termius-bin
_pkgname=no-more-termius
pkgver=0.4.1
pkgrel=1
pkgdesc="Keyboard-driven TUI to manage and open SSH connections, with a dual-pane SFTP browser (prebuilt binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/matheusrrocha/no-more-termius"
license=('MIT')
depends=('gcc-libs' 'glibc' 'libssh2' 'openssl' 'zlib')
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")

_asset="$url/releases/download/v$pkgver/$_pkgname-$pkgver"
source_x86_64=("$_pkgname-$pkgver-x86_64.tar.gz::$_asset-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("$_pkgname-$pkgver-aarch64.tar.gz::$_asset-aarch64-unknown-linux-gnu.tar.gz")
# Replace both with `updpkgsums` once the release assets exist.
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  install -Dm0755 -t "$pkgdir/usr/bin/" "$_pkgname"
  install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
  install -Dm0644 -t "$pkgdir/usr/share/doc/$pkgname/" README.md
}
